/target

# Pinned reading copies, not source: `scripts/fetch-upstream.sh` re-derives
# `upstream/<name>/` from `upstream/pins.toml` alone, so committing a checkout
# would pin the tree to whoever fetched last. Only the pins are reviewed.
upstream/*
!upstream/pins.toml

# Per-worktree Cargo config, generated by `scripts/new-worktree.sh` with
# machine-local absolute paths. Never reviewed, never committed.
/.cargo/

# Runtime state, not source: the log of which slices have been handed out on
# this machine. One contributor's history is not the project's, and committing it
# would make every other contributor's suppression window wrong.
.dovetail/
/.freebuff
